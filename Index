.sub p{margin:0;font-size:1rem;line-height:1.5}

/* ---------- barra: contador + buscador ---------- */
.bar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin:0 0 34px}
.count{position:relative;display:inline-block;padding:10px 30px 8px;transform:rotate(-3deg);
  font:400 1.45rem/1 var(--hand);text-transform:uppercase;letter-spacing:1px;color:var(--ink)}
.count svg{position:absolute;inset:-4px -6px;width:calc(100% + 12px);height:calc(100% + 8px);color:var(--bo);overflow:visible}
.find{display:flex;align-items:center;gap:10px}
.search{display:flex;align-items:center;gap:8px;padding:9px 16px;min-width:260px;border:1px solid #d3c9be;border-radius:30px;background:rgba(255,255,255,.55)}
.search svg{width:17px;height:17px;color:var(--bo);flex:none}
.search input{border:0;background:none;outline:none;width:100%;font-size:.95rem}
.search:focus-within{border-color:var(--bo)}
.find .dec{position:static;width:30px;height:30px}

/* ---------- panel del dueño/a ---------- */
