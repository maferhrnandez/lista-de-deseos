.adm-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.adm-h b{font:400 1.5rem/1 var(--hand);color:var(--bo)}
.link{background:none;border:0;padding:0;color:var(--muted);text-decoration:underline;cursor:pointer;font-size:.85rem}
.row{display:flex;gap:10px;flex-wrap:wrap}
.row input[type=text],.row input[type=url]{flex:1 1 220px;min-width:0;padding:11px 12px;border:1px solid #cfc6bb;background:#fff;border-radius:2px}
.row input:focus{outline:none;border-color:var(--bo)}
.row2{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:12px}
.pick{display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border:1.5px solid var(--bo);color:var(--bo);cursor:pointer;font:600 .8rem var(--cond);text-transform:uppercase;letter-spacing:.8px;background:#fff}
.pick:hover{background:#f6ecee}
.pick input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.pick svg{width:18px;height:18px}
.pv{display:flex;align-items:center;gap:8px;font-size:.85rem;color:var(--muted)}
.pv img{width:44px;height:44px;object-fit:cover;filter:grayscale(1);box-shadow:0 1px 3px rgba(0,0,0,.3)}
.add{margin-left:auto}

/* ---------- grilla de polaroids ---------- */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(205px,1fr));gap:40px 30px}
.card{position:relative;display:flex;flex-direction:column;background:var(--card);padding:12px 12px 16px;
  box-shadow:0 1px 1px rgba(0,0,0,.08),0 6px 14px rgba(0,0,0,.2);transform:rotate(var(--r,0deg));transition:transform .2s}
.card:hover{transform:rotate(0deg) translateY(-3px)}
.card.pin::before{content:"";position:absolute;z-index:6;left:-5px;top:-9px;width:22px;height:22px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#ef6a78 0,#b3182f 45%,#6d0717 85%);box-shadow:2px 4px 4px rgba(0,0,0,.4)}
.card.tape::before{content:"";position:absolute;z-index:6;left:50%;top:-11px;width:76px;height:24px;margin-left:-38px;
  background:rgba(48,44,44,.78);transform:rotate(-3deg);box-shadow:0 1px 2px rgba(0,0,0,.25)}
.phw{position:relative}
.ph{position:relative;aspect-ratio:1/1;background:#d9d3cb;overflow:hidden;display:flex;align-items:center;justify-content:center}
.ph img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.06);display:block}
.ph.empty svg{width:38%;height:38%;color:#a49a90}
.doo{position:absolute;z-index:5;width:30px;height:30px}
.doo.bl{left:-16px;bottom:8px;transform:rotate(-8deg)}
.doo.br{right:-16px;bottom:8px;transform:rotate(10deg)}
.doo.tr{right:-14px;top:-12px;transform:rotate(14deg)}
.doo.ml{left:-17px;top:56%;transform:rotate(-12deg)}
.card h3{margin:14px 4px 0;font:600 1rem/1.2 var(--cond);text-transform:uppercase;letter-spacing:.6px;word-break:break-word}
.nt{margin:3px 4px 14px;font:500 1.3rem/1.1 var(--note);min-height:1.1em;word-break:break-word}
.nt a{font-weight:700;white-space:nowrap}
.btn{display:block;margin-top:auto;width:100%;padding:11px 8px;border:0;background:var(--bo);color:#fff;cursor:pointer;
  font:600 .82rem/1.15 var(--cond);text-transform:uppercase;letter-spacing:.9px;transform:rotate(-.5deg);box-shadow:0 2px 0 rgba(0,0,0,.15)}
.btn:hover{background:var(--bo2)}
.btn:disabled{opacity:.6;cursor:wait}
.btn.ghost{background:transparent;color:var(--bo);box-shadow:inset 0 0 0 2px var(--bo)}
.btn.ghost:hover{background:rgba(122,15,38,.07)}
.btn.auto{width:auto;display:inline-block;padding:11px 26px;margin:0}
.stamp{display:none;position:absolute;z-index:3;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-12deg);
  padding:2px 14px;border:3px solid var(--bo);color:var(--bo);background:rgba(245,242,237,.86);
  font:400 1.6rem/1.15 var(--hand);text-transform:uppercase;white-space:nowrap}
.done .stamp{display:block}
.done .ph img{opacity:.45}
.done h3{text-decoration:line-through;text-decoration-color:var(--bo);text-decoration-thickness:2.5px}
.done .nt{opacity:.55}
.del{position:absolute;z-index:7;right:-9px;top:-9px;width:30px;height:30px;border-radius:50%;border:2px solid var(--bo);
  background:#fff;color:var(--bo);font-weight:700;cursor:pointer;line-height:1;box-shadow:0 2px 4px rgba(0,0,0,.3)}
.del:hover{background:var(--bo);color:#fff}
.msg{text-align:center;padding:34px 10px;color:var(--muted);font-size:1rem}

/* ---------- pie ---------- */
.gracias{position:relative;display:block;width:max-content;margin:58px auto 0;padding:12px 40px 10px;background:var(--card);
  box-shadow:0 3px 9px rgba(0,0,0,.28);transform:rotate(-2.5deg);color:var(--bo);font:400 2.1rem/1.1 var(--hand);text-transform:uppercase;letter-spacing:1px}
.gracias::after{content:"";position:absolute;left:24%;right:22%;bottom:9px;height:2px;background:var(--bo);transform:rotate(-1.5deg);border-radius:2px}
.own{display:block;margin:26px auto 0;position:relative;z-index:5}
.notes{position:absolute;z-index:5;right:clamp(96px,15vw,190px);bottom:clamp(70px,11vw,130px);width:clamp(46px,6vw,70px);height:clamp(70px,9vw,104px);color:var(--bo);pointer-events:none}
.notes svg{width:100%;height:100%;overflow:visible}

/* ---------- diálogos y avisos ---------- */
dialog{border:0;padding:0;background:transparent;max-width:min(420px,calc(100vw - 32px))}
dialog::backdrop{background:rgba(40,6,14,.55)}
.sheet{background:var(--card);padding:26px 24px 20px;box-shadow:0 10px 30px rgba(0,0,0,.4);transform:rotate(-.6deg);position:relative}
.sheet::before{content:"";position:absolute;left:50%;top:-12px;width:90px;height:24px;margin-left:-45px;background:rgba(48,44,44,.78);transform:rotate(2deg)}
.sheet h2{margin:0 0 8px;font:400 1.7rem/1.1 var(--hand);color:var(--bo)}
.sheet p{margin:0 0 18px}
.sheet .acts{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
.sheet label{display:block;font-size:.85rem;color:var(--muted);margin:0 0 4px}
.sheet input{width:100%;padding:11px 12px;border:1px solid #cfc6bb;background:#fff;margin-bottom:12px}
.sheet input:focus{outline:none;border-color:var(--bo)}
.err{color:#a3122b;font-size:.9rem;min-height:1.2em;margin:-4px 0 10px}
.toast{position:fixed;z-index:50;left:50%;bottom:22px;transform:translate(-50%,30px);opacity:0;max-width:calc(100vw - 32px);
  padding:12px 20px;background:#231a1b;color:#fff;border-left:5px solid #e0505f;box-shadow:0 6px 18px rgba(0,0,0,.35);
  transition:opacity .25s,transform .25s;pointer-events:none;font-size:.95rem}
.toast.on{opacity:1;transform:translate(-50%,0)}
.toast.bad{border-left-color:#f2b134}

