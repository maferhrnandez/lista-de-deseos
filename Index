    <span class="dec k-hide" style="left:56%;top:96px;width:44px;height:44px"><svg viewBox="0 0 40 40"><path d="M4 8l11 9M3 24h12M8 36l9-8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>
    <span class="dec k-hide" style="left:78%;top:70px;width:52px;height:52px"><svg viewBox="0 0 40 40"><path d="M36 6L24 16M38 22H25M33 36l-10-8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>
    <span class="dec k-hide" style="right:5%;top:250px;width:30px;height:46px"><svg viewBox="0 0 20 40"><path d="M5 4l3 14M15 8l-2 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>

    <h1><span class="a">Lista</span><span class="b">de deseos</span></h1>
    <div class="thx">Gracias<br>por ser<br>parte ♡</div>
    <div class="sub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx=".5"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8C10.5 4.5 7 4 6.3 5.8 5.6 7.6 9 8 12 8zM12 8c1.5-3.5 5-4 5.7-2.2C18.4 7.6 15 8 12 8z"/></g></svg>
      <p>Elegí un regalo. Cuando lo marques, se tachará automáticamente para que nadie más lo elija. Nadie sabrá que fuiste vos 🤭</p>
    </div>
  </header>

  <!-- ============ REGALOS ============ -->
  <main class="paper gal">
    <!-- Panel del dueño/a (solo visible después de iniciar sesión) -->
    <form id="adm" class="adm" hidden autocomplete="off">
      <div class="adm-h"><b>Agregar un regalo ✍️</b><button type="button" class="link" id="out">Cerrar sesión de dueño/a</button></div>
      <div class="row">
        <input type="text" id="ti" placeholder="Regalo (ej: Perfume)" maxlength="80" required aria-label="Nombre del regalo">
        <input type="text" id="no" placeholder="Nota (ej: Mi favorito ♡) o link" maxlength="300" aria-label="Nota o link">
      </div>
      <div class="row2">
        <label class="pick"><svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 8h4l2-3h6l2 3h4v11H3z"/><circle cx="12" cy="13" r="3.5"/></g></svg><span id="pickT">Foto (opcional)</span><input id="fo" type="file" accept="image/*"></label>
        <span class="pv" id="pv" hidden><img id="pvI" alt=""><button type="button" class="link" id="pvX">quitar</button></span>
        <span class="add"><button class="btn auto" id="ad" type="submit">Agregar regalo</button></span>
      </div>
    </form>

    <div class="bar">
      <span class="count"><svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true"><path d="M14 34C10 14 70 4 120 6s76 12 74 26-48 24-104 23S8 48 10 30 60 4 104 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg><span id="ct">0 regalos disponibles</span></span>
      <div class="find">
        <label class="search"><svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></g></svg><input id="q" type="search" placeholder="Buscar regalo..." aria-label="Buscar regalo"></label>
        <span class="dec" style="transform:rotate(-10deg)"><svg viewBox="0 0 24 24"><path d="M12 2.5l2.7 6.3 6.8.5-5.2 4.4 1.7 6.7L12 16.8l-6 3.6 1.7-6.7L2.5 9.3l6.8-.5zM8 9l8 8M16 9l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg></span>
      </div>
    </div>

    <div class="grid" id="ls" aria-live="polite"></div>
    <div class="msg" id="ms">Cargando regalos…</div>

    <span class="gracias">¡Gracias! ♡</span>
    <button class="link own" id="own" type="button">Soy el dueño/a de la lista</button>
  </main>

  <div class="notes" aria-hidden="true"><svg viewBox="0 0 40 60"><g fill="currentColor" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M14 6v18M14 6l12-3v16" fill="none"/><ellipse cx="10.5" cy="25" rx="4.2" ry="3.2" transform="rotate(-20 10.5 25)"/><ellipse cx="22.5" cy="20" rx="4.2" ry="3.2" transform="rotate(-20 22.5 20)"/><path d="M30 34v16" fill="none"/><path d="M30 34c3 2 6 3 6 7" fill="none"/><ellipse cx="26.5" cy="51" rx="4.2" ry="3.2" transform="rotate(-20 26.5 51)"/></g></svg></div>
  <img class="im d4" alt="" src="data:image/webp;base64,">
  <img class="im d5" alt="" src="data:image/webp;base64,">
</div>

<!-- Confirmación -->
<dialog id="dlg">
  <form method="dialog" class="sheet">
    <h2 id="dlgT"></h2>
    <p id="dlgP"></p>
    <div class="acts">
      <button class="btn ghost auto" value="no">Cancelar</button>
      <button class="btn auto" value="ok" id="dlgOk">Sí</button>
    </div>
  </form>
</dialog>

<!-- Ingreso del dueño/a -->
<dialog id="login">
  <form class="sheet" id="loginF">
    <h2>Hola, dueño/a ♡</h2>
    <p>Ingresá con la cuenta que creaste en Supabase para agregar o eliminar regalos.</p>
    <label for="le">Email</label>
    <input id="le" type="email" autocomplete="username" required>
    <label for="lp">Contraseña</label>
    <input id="lp" type="password" autocomplete="current-password" required>
    <div class="err" id="lerr" role="alert"></div>
    <div class="acts">
      <button class="btn ghost auto" type="button" id="lno">Cancelar</button>
      <button class="btn auto" type="submit" id="lok">Entrar</button>
    </div>
  </form>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  'use strict';

  /* ------------------------------------------------------------------ *
   *  Configuración                                                      *
   * ------------------------------------------------------------------ */
  // Acepta la URL aunque se pegue con /rest/v1/ u otra ruta al final.
  const SB_URL = String(window.SUPABASE_URL || '').trim().replace(/\/(rest|auth|storage|realtime)\/v1.*$/i, '').replace(/\/+$/, '');
  const SB_KEY = String(window.SUPABASE_KEY || '').trim();
  const BUCKET = 'regalos';      // bucket de fotos creado por supabase.sql
  const MAX_PHOTO = 1000;        // px del lado más largo al subir

  /* ------------------------------------------------------------------ *
   *  Utilidades                                                         *
   * ------------------------------------------------------------------ */
  const $ = id => document.getElementById(id);
  const el = (tag, cls, text) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };
  const norm = s => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const hash = s => { let h = 2166136261; for (const c of String(s)) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };
  const uid = () => (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2));

  const ICON = {
    star:   '<svg viewBox="0 0 24 24"><path d="M12 2.5l2.7 6.3 6.8.5-5.2 4.4 1.7 6.7L12 16.8l-6 3.6 1.7-6.7L2.5 9.3l6.8-.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>',
    heart:  '<svg viewBox="0 0 24 24"><path d="M12 20.5C5.5 15.5 3 12 3 8.6A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 9 1.6c0 3.4-2.5 6.9-9 11.9z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    check:  '<svg viewBox="0 0 24 24"><path d="M3 13.5l5.5 5.5L21.5 4M6 3.5l3.5 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    sparks: '<svg viewBox="0 0 24 24"><path d="M21 5l-6 4M22 13h-7M20 21l-5-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
    gift:   '<svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx=".5"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8C10.5 4.5 7 4 6.3 5.8 5.6 7.6 9 8 12 8zM12 8c1.5-3.5 5-4 5.7-2.2C18.4 7.6 15 8 12 8z"/></g></svg>'
  };
  const DOODLES = ['star', 'heart', 'check', 'sparks'];
  const SPOTS = ['bl', 'br', 'tr', 'ml'];

  let toastTimer;
  function toast(text, bad) {
    const t = $('toast');
    t.textContent = text;
    t.classList.toggle('bad', !!bad);
    t.classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('on'), bad ? 6000 : 3200);
  }

  function ask({ title, text, ok }) {
    const d = $('dlg');
    $('dlgT').textContent = title;
    $('dlgP').textContent = text;
    $('dlgOk').textContent = ok;
    if (typeof d.showModal !== 'function') return Promise.resolve(confirm(title + '\n\n' + text));
    d.returnValue = '';
    d.showModal();
    $('dlgOk').focus();
    return new Promise(res => d.addEventListener('close', () => res(d.returnValue === 'ok'), { once: true }));
  }

  function explain(err) {
    const m = String((err && (err.message || err.error_description || err.error)) || err || '');
    if (/row-level security|violates|permission denied|unauthorized|403/i.test(m))
      return 'Sin permiso: el email del SQL (is_owner) no coincide con la cuenta con la que entraste.';
    if (/bucket not found/i.test(m)) return 'Falta el bucket de fotos "regalos". Ejecutá supabase.sql en Supabase.';
    if (/does not exist|schema cache|PGRST205|42P01|42883/i.test(m)) return 'Falta ejecutar supabase.sql en Supabase (SQL Editor).';
    if (/payload too large|maximum allowed size|413/i.test(m)) return 'La foto es demasiado pesada. Probá con otra.';
    if (/failed to fetch|network/i.test(m)) return 'Sin conexión. Revisá internet e intentá de nuevo.';
    return 'No se pudo guardar: ' + m;
  }

  /* ------------------------------------------------------------------ *
   *  Estado                                                             *
   * ------------------------------------------------------------------ */
  let sb = null;
  let gifts = [];
  let isOwner = false;
  let loaded = false;
  let failed = '';
  const pending = new Set();

  const photoUrl = path => sb.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;

  /* ------------------------------------------------------------------ *
   *  Dibujo de la lista                                                 *
   * ------------------------------------------------------------------ */
  function fillNote(p, note) {
    if (!note) return;
    const re = /https?:\/\/[^\s<>"']+/g;
    let last = 0, m;
    while ((m = re.exec(note))) {
      if (m.index > last) p.append(note.slice(last, m.index));
      const a = el('a', null, 'ver link ↗');
      a.href = m[0]; a.target = '_blank'; a.rel = 'noopener noreferrer';
      p.append(a);
      last = m.index + m[0].length;
    }
    if (last < note.length) p.append(note.slice(last));
  }

  function card(g) {
    const h = hash(g.id);
    const c = el('article', 'card ' + ((h >>> 3) & 1 ? 'pin' : 'tape') + (g.taken ? ' done' : ''));
    c.style.setProperty('--r', ((h % 9) - 4) * 0.4 + 'deg');
    c.dataset.k = norm(g.title + ' ' + (g.note || ''));

    const wrap = el('div', 'phw');
    const ph = el('div', 'ph');
    const empty = () => { ph.classList.add('empty'); ph.insertAdjacentHTML('afterbegin', ICON.gift); };
    if (g.image_path) {
      const im = new Image();
      im.alt = g.title; im.loading = 'lazy'; im.decoding = 'async';
      im.onerror = () => { im.remove(); empty(); };
      im.src = photoUrl(g.image_path);
      ph.append(im);
    } else empty();
    ph.append(el('span', 'stamp', '¡Ya elegido!'));
    const doo = el('span', 'doo ' + SPOTS[(h >>> 7) % SPOTS.length]);
    doo.setAttribute('aria-hidden', 'true');
    doo.innerHTML = ICON[DOODLES[(h >>> 5) % DOODLES.length]];
    wrap.append(ph, doo);

    const t = el('h3', null, g.title);
    const n = el('p', 'nt'); fillNote(n, g.note);
    const b = el('button', 'btn' + (g.taken ? ' ghost' : ''), g.taken ? 'Desmarcar' : 'Elegir este regalo →');
    b.type = 'button';
    b.disabled = pending.has(g.id);
    b.addEventListener('click', () => toggle(g));
    c.append(wrap, t, n, b);

    if (isOwner) {
      const x = el('button', 'del', '✕');
      x.type = 'button'; x.title = 'Eliminar regalo'; x.setAttribute('aria-label', 'Eliminar ' + g.title);
      x.addEventListener('click', () => removeGift(g));
      c.append(x);
    }
    return c;
  }

  function render() {
    const free = gifts.filter(g => !g.taken).length;
    $('ct').textContent = free === 1 ? '1 regalo disponible' : free + ' regalos disponibles';
    $('ls').replaceChildren(...gifts.map(card));
    $('adm').hidden = !isOwner;
    $('own').hidden = isOwner || !sb;
    filter();
  }

  function filter() {
    const q = norm($('q').value.trim());
    let shown = 0;
    for (const c of $('ls').children) {
      const ok = !q || c.dataset.k.includes(q);
      c.hidden = !ok; if (ok) shown++;
    }
    let m = '';
    if (failed) m = failed;
    else if (!loaded) m = 'Cargando regalos…';
    else if (!gifts.length) m = isOwner ? 'Todavía no agregaste regalos. Usá el formulario de arriba ✍️' : 'La lista está vacía por ahora. ¡Volvé pronto! ♡';
    else if (!shown) m = 'No hay regalos con ese nombre.';
    $('ms').textContent = m;
    $('ms').hidden = !m;
  }

  /* ------------------------------------------------------------------ *
   *  Datos                                                              *
   * ------------------------------------------------------------------ */
  async function load() {
    const { data, error } = await sb.from('gifts')
      .select('id,title,note,image_path,taken,created_at')
      .order('created_at', { ascending: true });
    if (error) {
      console.error(error);
      if (!loaded) failed = /does not exist|schema cache|PGRST205|42P01/i.test(error.message + error.code)
        ? 'Falta ejecutar supabase.sql en Supabase (ver LEEME.md).'
        : 'No se pudo cargar la lista. Revisá la configuración (URL y key) e intentá de nuevo.';
      filter();
      return;
    }
    failed = ''; loaded = true;
    gifts = data.map(g => pending.has(g.id) ? { ...g, taken: (gifts.find(x => x.id === g.id) || g).taken } : g);
    render();
  }

  let loadTimer;
  const reloadSoon = () => { clearTimeout(loadTimer); loadTimer = setTimeout(load, 250); };

  async function toggle(g) {
    if (pending.has(g.id)) return;
    const choosing = !g.taken;
    const ok = await ask(choosing
      ? { title: '¿Elegís este regalo?', text: '“' + g.title + '” quedará tachado para todos. Nadie sabrá que fuiste vos 🤫', ok: 'Sí, lo elijo' }
      : { title: '¿Desmarcar este regalo?', text: 'Hacelo solo si vos lo elegiste y cambiaste de idea. Quedará disponible otra vez para los demás.', ok: 'Sí, desmarcar' });
    if (!ok) return;

    pending.add(g.id);
    g.taken = choosing;               // se ve al instante
    render();
    const { data, error } = await sb.rpc(choosing ? 'choose_gift' : 'release_gift', { gift_id: g.id });
    pending.delete(g.id);

    if (error) { console.error(error); g.taken = !choosing; toast('No se pudo guardar. Revisá tu conexión e intentá de nuevo.', true); }
    else if (data === false) toast(choosing ? '¡Uy! Alguien lo eligió justo antes que vos. Elegí otro ♡' : 'Ese regalo ya estaba disponible.', true);
    else toast(choosing ? '¡Listo! Regalo elegido ♡ Gracias' : 'Regalo desmarcado. Ya está disponible otra vez.');
    render();
    load();
  }

  /* ------------------------------------------------------------------ *
   *  Dueño/a: agregar y eliminar                                        *
   * ------------------------------------------------------------------ */
  function resize(file) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('No se pudo leer la foto. Probá con otra (JPG o PNG).')); };
      img.onload = () => {
        const k = Math.min(1, MAX_PHOTO / Math.max(img.naturalWidth, img.naturalHeight));
        const cv = document.createElement('canvas');
        cv.width = Math.round(img.naturalWidth * k);
        cv.height = Math.round(img.naturalHeight * k);
        const ctx = cv.getContext('2d');
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, cv.width, cv.height);
        ctx.drawImage(img, 0, 0, cv.width, cv.height);
        URL.revokeObjectURL(url);
        cv.toBlob(b => b ? resolve(b) : reject(new Error('No se pudo procesar la foto.')), 'image/jpeg', 0.82);
      };
      img.src = url;
    });
  }

  function clearPhoto() {
    $('fo').value = '';
    $('pv').hidden = true;
    $('pickT').textContent = 'Foto (opcional)';
    const old = $('pvI').src; if (old.startsWith('blob:')) URL.revokeObjectURL(old);
    $('pvI').removeAttribute('src');
  }

  $('fo').addEventListener('change', () => {
    const f = $('fo').files[0];
    if (!f) return clearPhoto();
    $('pvI').src = URL.createObjectURL(f);
    $('pv').hidden = false;
    $('pickT').textContent = 'Cambiar foto';
  });
  $('pvX').addEventListener('click', clearPhoto);

  $('adm').addEventListener('submit', async e => {
    e.preventDefault();
    const title = $('ti').value.trim();
    const note = $('no').value.trim();
    if (!title) { $('ti').focus(); return; }
    const btn = $('ad');
    btn.disabled = true; btn.textContent = 'Agregando…';
    let path = null;
    try {
      const f = $('fo').files[0];
      if (f) {
        btn.textContent = 'Subiendo foto…';
        const blob = await resize(f);
        path = uid() + '.jpg';
        const up = await sb.storage.from(BUCKET).upload(path, blob, { contentType: 'image/jpeg', cacheControl: '31536000', upsert: false });
        if (up.error) throw up.error;
      }
      const { error } = await sb.from('gifts').insert({ title, note: note || null, image_path: path });
      if (error) throw error;
      $('ti').value = ''; $('no').value = ''; clearPhoto();
      toast('Regalo agregado ♡');
      $('ti').focus();
      await load();
    } catch (err) {
      console.error(err);
      if (path) sb.storage.from(BUCKET).remove([path]);
      toast(err && err.message && err.message.startsWith('No se pudo') ? err.message : explain(err), true);
    } finally {
      btn.disabled = false; btn.textContent = 'Agregar regalo';
    }
  });

  async function removeGift(g) {
    const ok = await ask({ title: '¿Eliminar este regalo?', text: '“' + g.title + '” se quitará de la lista para todos.', ok: 'Sí, eliminar' });
    if (!ok) return;
    const { error } = await sb.from('gifts').delete().eq('id', g.id);
    if (error) { console.error(error); toast(explain(error), true); return; }
    if (g.image_path) sb.storage.from(BUCKET).remove([g.image_path]);
    gifts = gifts.filter(x => x.id !== g.id);
    render();
    toast('Regalo eliminado.');
  }

  /* ------------------------------------------------------------------ *
   *  Dueño/a: sesión                                                    *
   * ------------------------------------------------------------------ */
  async function checkOwner(fromLogin) {
    const { data: { session } } = await sb.auth.getSession();
    if (!session) { isOwner = false; render(); return; }
    const { data, error } = await sb.rpc('is_owner');
    isOwner = !error && data === true;
    if (!isOwner && fromLogin) {
      toast(error ? explain(error) : 'Esa cuenta no es la dueña de esta lista.', true);
      await sb.auth.signOut();
    } else if (isOwner && fromLogin) toast('¡Hola! Ya podés agregar regalos ✍️');
    render();
  }

  $('own').addEventListener('click', () => {
    $('lerr').textContent = '';
    $('login').showModal();
    $('le').focus();
  });
  $('lno').addEventListener('click', () => $('login').close());
  $('loginF').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = $('lok');
    btn.disabled = true; $('lerr').textContent = '';
    const { error } = await sb.auth.signInWithPassword({ email: $('le').value.trim(), password: $('lp').value });
    btn.disabled = false;
    if (error) {
      $('lerr').textContent = /invalid/i.test(error.message) ? 'Email o contraseña incorrectos.' : error.message;
      return;
    }
    $('lp').value = '';
    $('login').close();
    await checkOwner(true);
  });
  $('out').addEventListener('click', async () => {
    await sb.auth.signOut();
    isOwner = false;
    render();
    toast('Sesión cerrada.');
  });

  /* ------------------------------------------------------------------ *
   *  Inicio                                                             *
   * ------------------------------------------------------------------ */
  $('q').addEventListener('input', filter);

  const notConfigured = !/^https:\/\/.+/.test(SB_URL) || SB_URL.includes('TU-PROYECTO') || !SB_KEY || SB_KEY.startsWith('TU_');
  if (notConfigured) {
    failed = '⚙️ Falta configurar Supabase: abrí index.html y completá SUPABASE_URL y SUPABASE_KEY (ver LEEME.md).';
    render();
    return;
  }
  if (!window.supabase || !window.supabase.createClient) {
    failed = 'No se pudo cargar Supabase. Revisá tu conexión y recargá la página.';
    render();
    return;
  }

  sb = window.supabase.createClient(SB_URL, SB_KEY);
  render();
  load().then(() => checkOwner(false));

  // Tiempo real: si alguien elige o desmarca, se actualiza para todos.
  sb.channel('gifts-live')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'gifts' }, reloadSoon)
    .subscribe();
  // Respaldo: refresca al volver a la pestaña y cada 45 s.
  document.addEventListener('visibilitychange', () => { if (!document.hidden) reloadSoon(); });
  setInterval(() => { if (!document.hidden) load(); }, 45000);
})();
</script>
</body>
</html>
